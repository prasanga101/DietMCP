# Private server-side values. Never share this file or paste it in chat.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVER_KEY=YOUR_SERVER_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
# UUID of one existing Supabase Authentication user (not a database password).
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
PUBLIC_URL=https://diet.example.com
# OAuth is optional and disabled for the current deployment.
MCP_AUTH_ENABLED=false
# Only needed if MCP_AUTH_ENABLED=true:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_ID=
# Profile. Age is calculated on each log date using birth date.
BIRTH_DATE=YYYY-MM-DD
HEIGHT_CM=YOUR_HEIGHT_CM
WEIGHT_KG=YOUR_WEIGHT_KG
TARGET_WEIGHT_KG=YOUR_TARGET_KG
SEX=male
BASELINE_MULTIPLIER=1.2
# Optional manual baseline INCLUDING routine living, EXCLUDING logged exercise.
# BASELINE_KCAL=2500
TIMEZONE=Asia/Kathmandu
DATA_DIR=/tmp/dietmcp
EMAIL_TO=your-address@example.com
EMAIL_FROM=
RESEND_API_KEY=
REPORT_WEEKDAY=4
REPORT_HOUR=16
REPORT_MINUTE=0
WEEKLY_EMAIL_ENABLED=false
# Durable encrypted FastMCP OAuth storage. Keep on the persistent volume.
FASTMCP_HOME=/data/fastmcp
# DNS name pointing at the hosting server. Used by Docker's HTTPS proxy.
DIET_DOMAIN=diet.example.com

# Stable encryption key generated privately; use the SAME key on Render and GitHub.
STATE_ENCRYPTION_KEY=YOUR_PRIVATE_FERNET_KEY
STATE_BACKEND=supabase
